# Base local de demostracion. Las pruebas deben reemplazarla por una base temporal.
DATABASE_URL=sqlite:///./offline_payments.db

# Obligatorio para emitir y validar sesiones.
JWT_SECRET_KEY=replace-with-a-random-local-secret

# Semillas de demostracion deshabilitadas por defecto.
DEMO_SEED_ENABLED=false
DEMO_SEED_PASSWORD=

# Integraciones externas deshabilitadas por defecto.
MERCADO_PAGO_ENABLED=false
MERCADO_PAGO_WEBHOOK_SECRET=
LEGACY_INVENTORY_OPEN=false
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_NOTIFICATION_URL=
NGROK_ENABLED=false
NGROK_AUTH_TOKEN=
NGROK_DOMAIN=

CORS_ORIGINS=http://127.0.0.1:8000
INITIAL_BALANCE_CENTS=1000000
MAX_PAYMENT_CENTS=100000
MAX_OFFLINE_PAYMENTS=10
OFFLINE_AUTHORIZATION_SECONDS=86400
POS_REQUEST_SECONDS=120
